{
  "name": "promjs-plus",
  "version": "0.6.1",
  "description": "A Prometheus metrics registry implemented in TypeScript",
  "main": "./lib/index.cjs",
  "module": "./lib/index.mjs",
  "types": "./lib/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/index.d.mts",
        "default": "./lib/index.mjs"
      },
      "require": {
        "types": "./lib/index.d.cts",
        "default": "./lib/index.cjs"
      }
    }
  },
  "files": [
    "lib/**/*.!(tsbuildinfo)"
  ],
  "keywords": [
    "prometheus",
    "metrics",
    "client",
    "typescript"
  ],
  "bugs": {
    "url": "https://github.com/thibmeu/promjs-plus/issues"
  },
  "homepage": "https://github.com/thibmeu/promjs-plus#readme",
  "repository": "github:thibmeu/promjs-plus",
  "scripts": {
    "build": "tsdown src/index.ts -d lib --format esm,cjs --dts",
    "format": "oxlint src --fix",
    "lint": "oxlint src && eslint src",
    "test": "vitest --run",
    "bench": "vitest bench --run --reporter=verbose",
    "typecheck": "tsc --noEmit",
    "release": "npm run lint && npm run test && npm version && npm run build && npm run push",
    "push": "npm login && npm publish && git push --set-upstream origin main --follow-tags"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@babel/core": "^8.1.3",
    "@babel/eslint-parser": "^8.1.2",
    "eslint": "^10.15.0",
    "eslint-plugin-security": "^4.2.1",
    "oxlint": "^1.94.0",
    "prom-client": "^15.1.3",
    "tsdown": "^0.23.7",
    "typescript": "7.1.0-beta",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "tsdown": {
      "typescript": "$typescript"
    }
  }
}
